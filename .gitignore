# ===========================
# C++ Standard Ignore
# ===========================

# Object files
*.o
*.obj
*.lo
*.slo

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lai

# Shared objects / DLL / dylib
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# Debug files
*.pdb
*.ilk
*.dwo

# ===========================
# CMake / Build System
# ===========================

# Ignore ALL build outputs
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile
cmake_install.cmake
CTestTestfile.cmake
Testing/

# ===========================
# Dependencies fetched by CMake
# (Catch2, etc.)
# ===========================
_deps/

# ===========================
# Logs
# ===========================
*.log

# ===========================
# OS / Editor garbage
# ===========================
.DS_Store
Thumbs.db

# ===========================
# Project-specific
# ===========================
# Ignore generated student files
studentai_*.txt

# Ignore docs unless explicitly included
docs/html/
docs/latex/
